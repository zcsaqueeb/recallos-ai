# ---------------------------------------------------------------------------
# RECALLOS environment template — copy to .env and fill in. NEVER commit .env.
# ---------------------------------------------------------------------------

# SQLite (application state, memory mirror, evidence, lessons)
DATABASE_URL="file:./db/custom.db"

# --- Walrus Memory (via Tatum Storage API — live transport) ------------------
# Memory blobs are persisted to Walrus mainnet through Tatum's Storage API using
# the SAME Tatum key above (billed via Walrus on-chain storage fees, not credits):
#   POST /v4/data/storage/upload → jobId + blobId
#   GET  /v4/data/storage/upload/{jobId} → PENDING → UPLOADING → CERTIFIED
# Certified blobs include a Sui object id, on-chain tx digests, a ~4-epoch
# (~8 weeks, auto-renewed) storage window, and a public aggregator download URL.
WALRUS_MEMORY_NAMESPACE=recallos

# Optional advanced transport: official MemWal SDK relayer. If ALL three are set,
# they take precedence over the Tatum Storage API transport.
# NOTE: credentials saved through the Settings UI ("Your Walrus Memory credentials")
# take priority over these values. Remove the saved set in Settings to fall back here.
# WALRUS_MEMORY_DELEGATE_KEY=
# WALRUS_MEMORY_ACCOUNT_ID=
# WALRUS_MEMORY_SERVER_URL=

# --- Tatum (Sui gRPC gateway) ------------------------------------------------
# Server-side ONLY. Sent as x-api-key gRPC metadata; never exposed to the browser.
# The Sui Foundation deprecated legacy JSON-RPC in favor of gRPC and GraphQL, and
# Tatum transitioned its Sui infra to sui-{network}-grpc.gateway.tatum.io
# (Protocol Buffers over HTTP/2; all operations in src/lib/tatum/ are live-verified).
# NOTE: a Tatum API key saved through the Settings UI ("Your Tatum — Sui gateway key")
# takes priority over this value. Remove the saved key in Settings to fall back here.
TATUM_API_KEY=
# mainnet (recommended)
TATUM_SUI_NETWORK=mainnet
# gRPC call deadline in ms (optional; default 12000)
TATUM_TIMEOUT_MS=12000
